{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/gozei",
      "destination": "/?page=admin",
      "permanent": false
    },
    {
      "source": "/gozei/",
      "destination": "/?page=admin",
      "permanent": false
    },
    {
      "source": "/pendentes",
      "destination": "/?page=pendentes",
      "permanent": false
    },
    {
      "source": "/pendentes/",
      "destination": "/?page=pendentes",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/gozei",
      "destination": "/index.html"
    },
    {
      "source": "/pendentes",
      "destination": "/index.html"
    }
  ]
}
